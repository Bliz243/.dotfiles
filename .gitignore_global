# Global .gitignore - Only truly universal ignores
# Project-specific patterns belong in project .gitignore files

# ============================================================================
# Operating Systems
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# Editors & IDEs
# ============================================================================

# VSCode - only temp/cache files, not config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Vim / Neovim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
[._]*.un~

# ============================================================================
# Universal Temporary Files
# ============================================================================

*~
*.tmp
*.temp
*.bak
*.backup

# ============================================================================
# Security - Universal (credentials should never be committed anywhere)
# ============================================================================

# Private keys
*.pem
*.key
!*.pub

# Environment files with secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.test

# ============================================================================
# Ecosystem safety nets (project .gitignore should own the rest)
# ============================================================================

node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
